%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Inter, system-ui, sans-serif",
    "fontSize": "13px",
    "primaryColor": "#f8fafc",
    "primaryTextColor": "#0f172a",
    "primaryBorderColor": "#334155",
    "lineColor": "#64748b",
    "secondaryColor": "#e2e8f0",
    "tertiaryColor": "#f1f5f9"
  },
  "er": { "layoutDirection": "TB", "entityPadding": 12 }
}}%%
erDiagram
  %% ===== Content =====
  %% All user FKs on questions are nullable (SET NULL)
  users o|--o{ questions : "created_by / updated_by / reviewer / instructor / publisher"
  questions ||--o{ question_options : has
  questions ||--o{ question_hints : has
  questions ||--o{ question_versions : has
  users o|--o{ question_versions : created_by
  questions ||--o{ question_scopes : has
  questions ||--o{ question_review_requests : has
  users ||--o{ question_review_requests : requested_by
  users o|--o{ question_review_requests : reviewed_by
  questions ||--o{ question_instructor_reviews : has
  users ||--o{ question_instructor_reviews : instructor_id
  questions ||--o{ question_feedback : has
  questions ||--o{ question_similarity_matches : "pair low/high"
  questions o|--o{ questions : cloned_from_id
  users ||--o{ question_import_batches : uploaded_by
  question_import_batches ||--o{ questions : import_batch_id

  %% ===== Taxonomy / Blueprint =====
  %% Content classification = 3-level DAG: organ_systems -> subjects -> lessons
  blueprints ||--o{ blueprint_sections : has
  blueprint_sections ||--o{ core_clinical_topics : has

  organ_systems ||--o{ subject_organ_system : groups
  subjects ||--o{ subject_organ_system : "belongs (multi-parent)"
  subjects ||--o{ lesson_subject : groups
  lessons ||--o{ lesson_subject : "belongs (multi-parent)"

  questions ||--o{ question_lesson : tagged
  lessons ||--o{ question_lesson : tagged
  questions ||--o{ question_tags : tagged
  tags ||--o{ question_tags : tagged
  core_clinical_topics ||--o{ core_topic_lessons : maps
  lessons ||--o{ core_topic_lessons : maps
  core_clinical_topics ||--o{ core_topic_tags : tagged
  tags ||--o{ core_topic_tags : tagged

  %% ===== Runtime =====
  users ||--o{ question_sessions : owns
  exams o|--o{ question_sessions : "exam_id optional SET NULL"
  question_sessions ||--o{ question_session_snapshots : has
  question_sessions ||--o{ question_attempts : has
  question_sessions ||--o{ question_feedback : has
  users ||--o{ question_attempts : owns
  users ||--o{ question_status : tracks
  questions ||--o{ question_status : tracks
  users ||--o{ question_feedback : owns
  question_options o|--o{ question_feedback : "option_id optional SET NULL"
  %% logical only — no DB FK (survive hard-delete):
  %% questions }o..o{ question_session_snapshots : question_id
  %% questions }o..o{ question_attempts : question_id

  %% ===== Exam =====
  blueprints o|--o{ exams : "blueprint_id optional SET NULL"
  exams ||--o{ exam_topics : has
  core_clinical_topics ||--o{ exam_topics : allocates
  exams ||--o{ exam_question : contains
  questions ||--o{ exam_question : contains
  core_clinical_topics o|--o{ exam_question : "CCT optional SET NULL"

  users {
    bigint id PK
  }

  questions {
    uuid id PK
    string code UK
    bigint created_by FK "nullable"
    bigint updated_by FK "nullable"
    bigint reviewer_id FK "nullable"
    bigint instructor_id FK "nullable"
    uint instructor_review_cycle
    bigint instructor_1_id FK "nullable"
    string instructor_1_decision "nullable"
    bigint instructor_2_id FK "nullable"
    string instructor_2_decision "nullable"
    bigint publisher_id FK "nullable"
    uuid cloned_from_id FK "nullable self"
    string difficulty
    string status
    bool is_free
    bool exam_flag
    uint version
    uint published_version
    uuid import_batch_id FK "nullable"
    json key_info
    json stats_cache
    char64 content_fingerprint
    softDeletes deleted_at
  }

  question_options {
    bigint id PK "identity for grading"
    uuid question_id FK "CASCADE"
    string label "authoring-only"
    text content
    bool is_correct
    uint order "author order"
  }

  question_hints {
    bigint id PK
    uuid question_id FK "CASCADE"
    text content
    uint sort_order
    string status
  }

  question_versions {
    bigint id PK
    uuid question_id FK "CASCADE"
    uint version
    json snapshot
    string event
    bigint created_by FK "nullable"
  }

  question_scopes {
    bigint id PK
    uuid question_id FK "CASCADE"
    string scope_type
    string scope_key
  }

  question_review_requests {
    bigint id PK
    uuid question_id FK "CASCADE"
    string action
    string status
    bigint requested_by FK "CASCADE"
    bigint reviewed_by FK "nullable"
  }

  question_instructor_reviews {
    bigint id PK
    uuid question_id FK "CASCADE"
    uint review_cycle
    bigint instructor_id FK "CASCADE"
    string decision "approved/rejected"
    char64 content_fingerprint "nullable"
  }

  question_import_batches {
    uuid id PK
    bigint uploaded_by FK
    string format
    string status
    json column_map
    json stats
  }

  question_feedback {
    bigint id PK
    uuid question_id FK "CASCADE"
    uuid question_session_id FK "CASCADE"
    bigint user_id FK "CASCADE"
    bigint question_option_id FK "nullable"
    string target
    string category
    string status
  }

  question_similarity_matches {
    bigint id PK
    uuid question_id_low FK "CASCADE"
    uuid question_id_high FK "CASCADE"
    decimal score
    string severity
  }

  blueprints {
    bigint id PK
    string slug UK
    string code UK
    string status
  }

  blueprint_sections {
    bigint id PK
    bigint blueprint_id FK "CASCADE"
    string slug
    string status
  }

  core_clinical_topics {
    bigint id PK
    bigint blueprint_section_id FK "CASCADE"
    string slug
    string status
  }

  organ_systems {
    bigint id PK
    string name
    string slug UK
    string code "nullable"
    text description "nullable"
    string status "active/inactive"
    uint sort_order
  }

  subjects {
    bigint id PK
    string name
    string slug UK
    string code "nullable"
    text description "nullable"
    string status "active/inactive"
    uint sort_order
  }

  lessons {
    bigint id PK
    string name
    string slug UK
    string code "nullable"
    text description "nullable"
    string status "active/inactive"
    uint sort_order
  }

  tags {
    bigint id PK
    string slug UK
    string type
    string status
  }

  subject_organ_system {
    bigint subject_id FK "CASCADE"
    bigint organ_system_id FK "CASCADE"
    uint sort_order
  }

  lesson_subject {
    bigint lesson_id FK "CASCADE"
    bigint subject_id FK "CASCADE"
    uint sort_order
  }

  question_lesson {
    uuid question_id FK "CASCADE"
    bigint lesson_id FK "CASCADE"
  }

  question_tags {
    uuid question_id FK "CASCADE"
    bigint tag_id FK "CASCADE"
  }

  core_topic_lessons {
    bigint core_clinical_topic_id FK "CASCADE"
    bigint lesson_id FK "CASCADE"
  }

  core_topic_tags {
    bigint core_clinical_topic_id FK "CASCADE"
    bigint tag_id FK "CASCADE"
  }

  question_sessions {
    uuid id PK
    bigint user_id FK "CASCADE"
    bigint exam_id FK "nullable SET NULL"
    string mode
    string status
    string source
    json filters
    json question_ids
    softDeletes deleted_at
  }

  question_session_snapshots {
    bigint id PK
    uuid session_id FK "CASCADE"
    uuid question_id "NO FK"
    uint position
    json payload
  }

  question_attempts {
    bigint id PK
    uuid session_id FK "CASCADE"
    bigint user_id FK "CASCADE"
    uuid question_id "NO FK"
    json selected_option_ids
    bool is_correct
  }

  question_status {
    bigint id PK
    bigint user_id FK "CASCADE"
    uuid question_id FK "CASCADE"
    string status
    uint attempts_count
  }

  exams {
    bigint id PK
    bigint blueprint_id FK "nullable SET NULL"
    string title
    string status
    bool is_published
  }

  exam_topics {
    bigint id PK
    bigint exam_id FK "CASCADE"
    bigint core_clinical_topic_id FK "CASCADE"
    int question_count
    json difficulty_counts
  }

  exam_question {
    bigint id PK
    bigint exam_id FK "CASCADE"
    uuid question_id FK "CASCADE"
    bigint core_clinical_topic_id FK "nullable"
    int order
  }
