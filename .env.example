APP_NAME=MedLearn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Port Nginx publish ra host (đổi khi 80 đã bị chiếm), nhớ khớp với APP_URL.
APP_PORT=80

# Token bảo vệ public/check.php (?token=...). Đổi mạnh trên production; xóa check.php sau khi kiểm tra.
CHECK_TOKEN=medlearn-check-change-me

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging (structured JSON in non-local — see kien-truc §7)
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL 8) — host = docker-compose service name
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
# Port publish ra host (đổi khi 3306 đã bị chiếm); nội bộ container vẫn là 3306.
FORWARD_DB_PORT=3306
DB_DATABASE=medlearn
DB_USERNAME=medlearn
DB_PASSWORD=secret

# Optional read replica for heavy analytics/report queries
DB_READ_HOST=mysql

# ---------------------------------------------------------------------------
# Redis (cache / queue / session / rate limiter / presence)
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Port publish ra host (đổi khi 6379 đã bị chiếm); nội bộ container vẫn 6379.
FORWARD_REDIS_PORT=6379

# Port publish ra host cho các service phụ trợ (đổi khi trùng cổng máy host).
# Nội bộ container không đổi.
# FORWARD_MEILI_PORT=7700
# FORWARD_MAILPIT_SMTP_PORT=1025
# FORWARD_MAILPIT_UI_PORT=8025
# FORWARD_ADMINER_PORT=8081

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=43200
AUTH_SESSION_MAX_DAYS=30
AUTH_SESSION_IDLE_HOURS=24
AUTH_TWO_FACTOR_TRUST_DAYS=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
AUDIT_QUEUE_ENABLED=true
AUDIT_QUEUE=audit
AUDIT_ACTIVITY_ENABLED=true
# Phiên bỏ dở (có start, không leave) được gom sau N giây.
AUDIT_ACTIVITY_IDLE_SECONDS=300
# Cùng màn hình trong N phút chỉ giữ 1 dòng hoạt động (tránh duplicate khi refresh).
AUDIT_ACTIVITY_COALESCE_MINUTES=30
AUDIT_ACTIVITY_REDIS_CONNECTION=default
AUDIT_HOT_RETENTION_DAYS=180
AUDIT_ARCHIVE_DISK=local
AUDIT_ARCHIVE_PATH=audit-archives
HORIZON_PREFIX=medlearn_horizon

# ---------------------------------------------------------------------------
# Search (Meilisearch via Laravel Scout)
# ---------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=search
SCOUT_AFTER_COMMIT=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKeyChangeMe

# ---------------------------------------------------------------------------
# Broadcasting (Laravel Reverb / WebSocket)
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=medlearn
REVERB_APP_KEY=medlearnkey
REVERB_APP_SECRET=medlearnsecret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Port publish ra host (đổi khi 8080 bị chiếm); nội bộ container vẫn 8080.
FORWARD_REVERB_PORT=8080
# Payload WS (câu hỏi HTML / text marks). Default upstream 10KB → "Payload too large".
REVERB_APP_MAX_MESSAGE_SIZE=250000
REVERB_MAX_REQUEST_SIZE=250000

# Browser-side (Vite) — points at the host-exposed Reverb port
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${FORWARD_REVERB_PORT}"
VITE_REVERB_SCHEME=http
# Chỉ bật khi frontend thực sự đăng ký kênh realtime.
VITE_REVERB_ENABLED=true

# ---------------------------------------------------------------------------
# LiveKit (Classroom livestream — self-host SFU, không bắt buộc Cloud)
# Keys MUST match docker/livekit/livekit.yaml → keys:
# ---------------------------------------------------------------------------
# URL trình duyệt dùng để nối WebRTC (host machine → published port)
LIVEKIT_URL=ws://127.0.0.1:7880
# IP LAN của máy chạy Docker, phải truy cập được từ browser.
# macOS: ipconfig getifaddr en0 (ví dụ 192.168.1.22)
LIVEKIT_NODE_IP=127.0.0.1
# URL server-to-server bên trong Docker; trình duyệt không dùng URL này.
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=medlearn_dev_key
LIVEKIT_API_SECRET=medlearn_dev_secret_change_me_32_chars
LIVEKIT_TOKEN_TTL=3600
# Port publish ra host (đổi khi 7880 bị chiếm)
FORWARD_LIVEKIT_PORT=7880
FORWARD_LIVEKIT_RTC_TCP_PORT=7881
FORWARD_LIVEKIT_RTC_UDP_PORT=7882

# Classroom: cho phép host lớp khi chưa có Billing Premium (local = true)
# CLASSROOM_OPEN_HOSTING=true

# Xác thực webhook LiveKit gửi về Laravel để ghi nhận điểm danh.
LIVEKIT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Storage (local disk — storage/app; public files via storage:link)
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Mail (Mailpit locally)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@medlearn.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# Port Vite dev server (đổi khi 5173 đã bị chiếm).
VITE_PORT=5173

# ---------------------------------------------------------------------------
# Database seeding (bộ demo cố định luôn chạy; volume tùy chọn)
# ---------------------------------------------------------------------------
# Bật để sinh khối lượng lớn phục vụ test hiệu năng/tìm kiếm/phân trang.
SEED_VOLUME=false
SEED_QUESTIONS=2000
SEED_STUDENTS=50
SEED_ATTEMPTS_PER_STUDENT=300

# ---------------------------------------------------------------------------
# Billing / payments (Module 28–29) — see docs/billing-subscription-redesign.md
# ---------------------------------------------------------------------------
BILLING_DEFAULT_GATEWAY=vnpay
BILLING_CURRENCY=VND
BILLING_TAX_RATE=0
BILLING_CHECKOUT_TTL_MINUTES=60
BILLING_ENTITLEMENT_CACHE_TTL=300
# Fake gateway: chỉ dùng trong PHPUnit (không hiện trên Admin → Cổng thanh toán)
BILLING_FAKE_GATEWAY=false

# VNPay (cổng mặc định)
# Runtime override: Admin → Billing → Cổng thanh toán
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo / ZaloPay (Phase 2 adapters; credentials can be stored in Admin)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create

# AI Services ( AI hỗ trợ support và chatbot)
OPENAI_API_KEY=sk-ijklmnopqrstuvwxijklmnopqrstuvwxijklmnop
OPENAI_SUPPORT_MODEL=gpt-4.1-mini

# AI Tutor — mặc định qua env; Admin → Cài đặt → tab "AI Tutor" ghi đè runtime (quota/cache/model).
# Để trống driver = tự chọn: có OPENAI_API_KEY -> openai, không thì FakeTutorClient.
AI_TUTOR_DRIVER=
AI_TUTOR_MODEL=gpt-4.1-mini
AI_TUTOR_GUARDRAIL_MODEL=gpt-4.1-mini
AI_TUTOR_MAX_TOKENS=900
AI_TUTOR_TIMEOUT=60
# Quota Free/ngày; Premium (ai.tutor) soft-cap/ngày; Staff vẫn unlimited. (override bằng Admin settings)
AI_TUTOR_FREE_DAILY_LIMIT=10
AI_TUTOR_PREMIUM_DAILY_LIMIT=100
# Số tin history gửi model (user+assistant, lấy mới nhất).
AI_TUTOR_HISTORY_MAX_MESSAGES=8
# Cache output auto-start trùng CONTEXT (Redis/file); TTL giây — Admin dùng đơn vị ngày.
AI_TUTOR_RESPONSE_CACHE=true
AI_TUTOR_RESPONSE_CACHE_TTL=604800
# Cửa sổ chống trùng auto-start (giây) cho POST /threads và /messages.
AI_TUTOR_IDEMPOTENCY_TTL=120
# Queue Horizon chạy job stream trả lời.
AI_TUTOR_QUEUE=default
