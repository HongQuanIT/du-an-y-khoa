APP_NAME=MedLearn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Port Nginx publish ra host (đổi khi 80 đã bị chiếm), nhớ khớp với APP_URL.
APP_PORT=80

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging (structured JSON in non-local — see kien-truc §7)
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL 8) — host = docker-compose service name
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
# Port publish ra host (đổi khi 3306 đã bị chiếm); nội bộ container vẫn là 3306.
FORWARD_DB_PORT=3306
DB_DATABASE=medlearn
DB_USERNAME=medlearn
DB_PASSWORD=secret

# Optional read replica for heavy analytics/report queries
DB_READ_HOST=mysql

# ---------------------------------------------------------------------------
# Redis (cache / queue / session / rate limiter / presence)
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Port publish ra host (đổi khi 6379 đã bị chiếm); nội bộ container vẫn 6379.
FORWARD_REDIS_PORT=6379

# Port publish ra host cho các service phụ trợ (đổi khi trùng cổng máy host).
# Nội bộ container không đổi.
# FORWARD_MEILI_PORT=7700
# FORWARD_MINIO_PORT=9000
# FORWARD_MINIO_CONSOLE_PORT=9001
# FORWARD_MAILPIT_SMTP_PORT=1025
# FORWARD_MAILPIT_UI_PORT=8025

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
HORIZON_PREFIX=medlearn_horizon

# ---------------------------------------------------------------------------
# Search (Meilisearch via Laravel Scout)
# ---------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKeyChangeMe

# ---------------------------------------------------------------------------
# Broadcasting (Laravel Reverb / WebSocket)
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=medlearn
REVERB_APP_KEY=medlearnkey
REVERB_APP_SECRET=medlearnsecret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Port publish ra host (đổi khi 8080 bị chiếm); nội bộ container vẫn 8080.
FORWARD_REVERB_PORT=8080

# Browser-side (Vite) — points at the host-exposed Reverb port
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${FORWARD_REVERB_PORT}"
VITE_REVERB_SCHEME=http

# ---------------------------------------------------------------------------
# Storage (S3-compatible: MinIO locally, R2/S3 in prod) + CDN
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=medlearn
AWS_SECRET_ACCESS_KEY=medlearnsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=medlearn
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/medlearn
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Mail (Mailpit locally)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@medlearn.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# Port Vite dev server (đổi khi 5173 đã bị chiếm).
VITE_PORT=5173

# ---------------------------------------------------------------------------
# Database seeding (bộ demo cố định luôn chạy; volume tùy chọn)
# ---------------------------------------------------------------------------
# Bật để sinh khối lượng lớn phục vụ test hiệu năng/tìm kiếm/phân trang.
SEED_VOLUME=false
SEED_QUESTIONS=2000
SEED_STUDENTS=50
SEED_ATTEMPTS_PER_STUDENT=300
